# Local development defaults. Copy to .env only when values need overriding.
# Never commit .env or use real organization data in this demonstration.
APP_ENV=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.1
LLM_CONTEXT_LENGTH=4096
LLM_MAX_OUTPUT_TOKENS=384
LLM_KEEP_ALIVE=1m
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PORT=6333
QDRANT_BIND_HOST=127.0.0.1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_COLLECTION=synthetic_policies_e5_small_v1
RAG_MIN_SCORE=0.805
RAG_CHUNK_TARGET_CHARS=650
RAG_CHUNK_OVERLAP_CHARS=80
ML_MODEL_PATH=models/anomaly/isolation_forest_daily_v1.joblib
# Set these in an ignored local .env before starting PostgreSQL or running Alembic.
# POSTGRES_USER=<local-demo-user>
# POSTGRES_PASSWORD=<generate-a-local-random-password>
# POSTGRES_DB=<local-demo-database>
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:<port>/<database>
# Required for Phase 5 API startup. Use two distinct random values of at least 24 characters.
# DEMO_API_TOKEN=<generate-a-local-random-admin-token>
# DEMO_READ_TOKEN=<generate-a-local-random-reader-token>
# CORS_ORIGINS=["http://localhost:8501"]
# Streamlit's HTTP target. Supply the demo bearer token in the UI session.
ESIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
