# Local development defaults. Copy to .env only when values need overriding.
# Never commit .env or use real organization data in this demonstration.
APP_ENV=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
QDRANT_URL=http://127.0.0.1:6333
# Set these in an ignored local .env before starting PostgreSQL or running Alembic.
# POSTGRES_USER=<local-demo-user>
# POSTGRES_PASSWORD=<generate-a-local-random-password>
# POSTGRES_DB=<local-demo-database>
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:<port>/<database>
# DEMO_API_TOKEN is reserved for a later API phase.
# DEMO_API_TOKEN=<generate-a-local-random-token>
